# Copy to server/.env and edit. All values are optional; these are the defaults.
PORT=4000
# Python model service (app/model_service). Run it on this URL.
MODEL_SERVICE_URL=http://127.0.0.1:8001
# Local MongoDB. Used when MONGO_MODE=local, or first in MONGO_MODE=auto.
MONGODB_URI=mongodb://127.0.0.1:27017/emotion_app
# local = MONGODB_URI only | memory = mongodb-memory-server only | auto = local, else memory (dev fallback)
MONGO_MODE=auto
MAX_IMAGE_MB=10
# Webcam summaries are stored at most once per this many ms (only when "Save session" is ticked)
SAVE_INTERVAL_MS=1000
UPSTREAM_TIMEOUT_MS=15000

# --- Wellbeing check-in (Gemini). Put the real key in server/.env, never in this file. ---
# Without a key the wellbeing module runs in a clearly labelled MOCK mode with canned questions.
GEMINI_API_KEY=
# Picked from the Gemini list-models endpoint: a current, stable "flash" model that supports generateContent.
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is overloaded (429/503) or missing (404).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Shown in the fixed safety message.
COUNSELLOR_CONTACT=your college counselling centre
# User messages per check-in (6 to 10).
WELLBEING_MAX_TURNS=8
# Optional natural voice for the voice interview (Gemini text-to-speech)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
